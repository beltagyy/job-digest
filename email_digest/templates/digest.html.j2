<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Digest - {{ run_date }}</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f4f5f7; margin: 0; padding: 20px; color: #24292e; }
    .container { max-width: 700px; margin: 0 auto; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .header { background: linear-gradient(135deg, #0073b1, #00a0dc); padding: 28px 32px; color: white; }
    .header h1 { margin: 0 0 4px; font-size: 22px; }
    .header p { margin: 0; opacity: 0.85; font-size: 14px; }
    .stats { background: #f0f7ff; padding: 14px 32px; font-size: 13px; color: #0073b1; border-bottom: 1px solid #dde6ed; }
    .country-section { padding: 0 32px 20px; }
    .country-title { font-size: 16px; font-weight: 700; margin: 24px 0 12px; padding-bottom: 6px; border-bottom: 2px solid #e1e4e8; }
    .job-card { border: 1px solid #e1e4e8; border-radius: 8px; padding: 18px; margin-bottom: 16px; }
    .job-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .job-title { font-size: 15px; font-weight: 600; color: #0073b1; text-decoration: none; }
    .job-title:hover { text-decoration: underline; }
    .job-meta { font-size: 12px; color: #6e7681; margin: 6px 0; }
    .job-meta span { margin-right: 12px; }
    .badges { display: flex; gap: 6px; flex-wrap: wrap; margin: 8px 0; }
    .badge { font-size: 11px; padding: 2px 8px; border-radius: 12px; font-weight: 500; }
    .badge-relocation { background: #dafbe1; color: #1a7f37; }
    .badge-remote { background: #ddf4ff; color: #0550ae; }
    .badge-source { background: #f6f8fa; color: #57606a; border: 1px solid #d0d7de; }
    .reasons { font-size: 12px; color: #3d4451; margin: 8px 0 0; }
    .reasons strong { color: #1a7f37; }
    .missing { font-size: 11px; color: #9e6a03; margin: 4px 0 6px; }
    .cover-letter-box { background: #f8f9ff; border-left: 3px solid #0073b1; border-radius: 0 6px 6px 0; padding: 12px 14px; margin: 12px 0; }
    .cover-letter-label { font-size: 10px; font-weight: 700; color: #0073b1; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
    .cover-letter-text { font-size: 12.5px; color: #2d3748; line-height: 1.6; white-space: pre-line; }
    .apply-btn { display: inline-block; margin-top: 10px; background: #0073b1; color: white; text-decoration: none; padding: 7px 18px; border-radius: 6px; font-size: 13px; font-weight: 600; }
    .apply-btn:hover { background: #005f94; }
    .empty { text-align: center; padding: 48px 32px; color: #6e7681; }
    .footer { background: #f6f8fa; padding: 16px 32px; font-size: 11px; color: #6e7681; text-align: center; border-top: 1px solid #e1e4e8; }
  </style>
</head>
<body>
<div class="container">
  <div class="header">
    <h1>Job Digest — {{ run_date }}</h1>
    <p>{{ total_jobs }} curated matches (≥{{ min_score }}%) across {{ countries | length }} countries · with tailored cover letters</p>
  </div>

  <div class="stats">
    Searching: Germany · Netherlands · Czech Republic (Prague) · Hungary · Austria · Ireland &nbsp;|&nbsp;
    Min match: {{ min_score }}% &nbsp;|&nbsp;
    Sources: LinkedIn · Indeed
  </div>

  {% if total_jobs == 0 %}
  <div class="empty">
    <p>No new matches this run. Next digest in ~2 days.</p>
  </div>
  {% else %}

  {% for country, jobs in grouped.items() %}
  <div class="country-section">
    <div class="country-title">
      {{ country }} &nbsp;<span style="font-weight:400;color:#6e7681;font-size:13px;">{{ jobs|length }} match{{ 'es' if jobs|length != 1 else '' }}</span>
    </div>

    {% for job in jobs %}
    <div class="job-card">
      <div class="job-header">
        <a class="job-title" href="{{ job.url }}" target="_blank">{{ job.title }}</a>
        <span style="background:{% if job.score >= 85 %}#1a7f37{% elif job.score >= 75 %}#0073b1{% else %}#6e5a00{% endif %};color:white;font-size:12px;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;flex-shrink:0;">{{ job.score }}% match</span>
      </div>

      <div class="job-meta">
        <span>🏢 {{ job.company }}</span>
        <span>📍 {{ job.location }}</span>
        {% if job.date_posted %}<span>🗓 {{ job.date_posted }}</span>{% endif %}
      </div>

      <div class="badges">
        {% if job.known_relocator %}<span class="badge" style="background:#fff3cd;color:#856404;border:1px solid #ffc107;">⭐ Known Relocator</span>{% endif %}
        {% if job.relocation %}<span class="badge badge-relocation">✅ Relocation Mentioned</span>{% endif %}
        {% if job.is_remote %}<span class="badge badge-remote">🌐 Remote</span>{% endif %}
        <span class="badge badge-source">{{ job.source }}</span>
      </div>

      {% if job.reasons %}
      <div class="reasons"><strong>✓ Why it matches:</strong> {{ job.reasons | join(' · ') }}</div>
      {% endif %}
      {% if job.missing %}
      <div class="missing">⚠ Gaps: {{ job.missing | join(', ') }}</div>
      {% endif %}

      {% if job.cover_letter %}
      <div class="cover-letter-box">
        <div class="cover-letter-label">✍ Tailored Cover Letter</div>
        <div class="cover-letter-text">{{ job.cover_letter }}</div>
      </div>
      {% endif %}

      <a class="apply-btn" href="{{ job.url }}" target="_blank">View & Apply →</a>
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  {% endif %}

  <div class="footer">
    Generated by your Job Digest Bot · Next run in ~2 days
  </div>
</div>
</body>
</html>
